DATABASE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Exact trusted origin; HTTPS is required for public production hosts.
AUTH_ORIGIN=http://localhost:3000
# Development accounts work only on localhost and require BOTH explicit flags for seeding.
ALLOW_DEV_SEED=false
AUTH_ALLOW_DEV_ACCOUNTS=false
# Optional private HTTPS email gateway; see AUTHENTICATION.md for contract.
AUTH_EMAIL_WEBHOOK_URL=
AUTH_EMAIL_WEBHOOK_SECRET=
