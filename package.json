{
  "name": "nova-university",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx db/migrate.ts",
    "db:seed": "node --import tsx db/seed.ts && node --import tsx db/seed-cms.ts",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx tests/academic.integration.ts",
    "db:seed:cms": "node --import tsx db/seed-cms.ts",
    "test:integration:cms": "node --import tsx tests/cms.integration.ts",
    "test:database:cms": "node --import tsx tests/cms.database.ts",
    "db:seed:auth": "node --import tsx db/seed-auth.ts",
    "auth:dev-token": "node --import tsx scripts/auth-token.ts",
    "auth:prune": "node --import tsx scripts/auth-prune.ts",
    "test:integration:auth": "node --import tsx tests/auth.integration.ts",
    "test:database:auth": "node --import tsx tests/auth.database.ts",
    "test:integration:auth:recovery": "node --import tsx tests/auth-recovery.integration.ts",
    "db:seed:student": "node --import tsx db/seed-student.ts",
    "test:integration:student": "node --import tsx tests/student.integration.ts",
    "test:database:student": "node --import tsx tests/student.database.ts",
    "db:seed:faculty": "node --import tsx db/seed-faculty.ts",
    "test:integration:faculty": "node --import tsx tests/faculty.integration.ts",
    "test:database:faculty": "node --import tsx tests/faculty.database.ts",
    "db:seed:admin": "node --import tsx db/seed-admin.ts",
    "test:admin": "node --import tsx --test tests/admin-*.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.16.0",
    "next": "16.3.3",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "5.7.3"
  }
}
